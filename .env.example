# Frontend (Vite) — where the app finds the API
VITE_API_BASE_URL=http://localhost:4000

# docker-compose.yml — used when running the full stack (postgres + api) via Docker.
# Copy to .env and adjust for each environment (your machine now, the client's server later);
# defaults work fine for local dev.
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital_intake
POSTGRES_PORT=5433
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Public domain patients' phones will load after scanning the QR code, e.g. intake.hospital.example.
# Caddy auto-issues a Let's Encrypt certificate for a real domain, or falls back to a
# self-signed one for "localhost" / a bare LAN IP during local testing.
APP_DOMAIN=localhost
